# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APPS_SCRIPT_URL: The deployed Google Apps Script Web App /exec URL that
# provides customer/job database storage and authentication.
# See apps-script/README.md for the setup steps.
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# VITE_GOOGLE_CLIENT_ID: OAuth *Web* client id used by Google Identity Services
# to obtain the ID token the backend verifies. Must match ALLOWED_CLIENT_ID in
# the Apps Script Script Properties.
VITE_GOOGLE_CLIENT_ID="XXXXXXXX.apps.googleusercontent.com"

# VITE_DEV_SHARED_SECRET: DEVELOPER BYPASS — disables database authentication
# entirely. Set this ONLY for local testing when the OAuth origin cannot be
# registered. It must exactly match the SHARED_SECRET Script Property in the
# Apps Script project. Leave it empty (or delete the line) in production.
VITE_DEV_SHARED_SECRET=""

# VITE_DEEPSEEK_API_KEY: OPTIONAL override for the DeepSeek key used in AI intake
# analysis. The key is built into the application (src/services/deepseekIntake.ts),
# so this only needs to be set when a different key should take priority. The AI
# reads pasted intake text or the text extracted from an uploaded PDF, understands
# the document, and routes each value into the correct Master Job Record field.
VITE_DEEPSEEK_API_KEY=""
