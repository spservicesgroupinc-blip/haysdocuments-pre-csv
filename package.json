{
  "name": "hays-sons-document-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "icons": "pwa-assets-generator && node scripts/generate-desktop-icon.mjs",
    "desktop:dev": "node scripts/build-electron.mjs && electron .",
    "desktop:build": "npm run build && node scripts/build-electron.mjs && electron-builder --win",
    "desktop:release": "npm run desktop:build && node scripts/prepare-desktop-release.mjs",
    "deploy:web": "vercel build --prod && vercel deploy --prebuilt --prod",
    "lint": "tsc --noEmit",
    "apps:ascii": "tsx scripts/check-appsscript-ascii.ts",
    "apps:chunks": "node scripts/make-paste-chunks.mjs",
    "apps:paste": "node scripts/make-paste-file.mjs",
    "apps:test": "tsx scripts/test-apps-script.ts",
    "apps:test:drafts": "tsx scripts/test-apps-script-drafts.ts",
    "database:test": "tsx --test scripts/test-database-transport.ts scripts/test-database-sync.ts",
    "save:ui:test": "playwright test --config scripts/playwright-save.config.ts",
    "apps:register": "tsx scripts/test-registration.ts",
    "parser:test": "tsx scripts/test-intake-parser.ts",
    "spans:test": "tsx scripts/test-pdf-spans.ts",
    "verify": "npm run lint && npm run apps:ascii && npm run apps:paste && npm run apps:test && npm run apps:register && npm run parser:test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
